{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://u.80aj.com/schemas/token-usage-ingest.schema.json",
  "title": "Local token usage ingest payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "installation_id",
    "observed_at",
    "today_tokens",
    "total_tokens",
    "today_cost_usd",
    "total_cost_usd",
    "cost_label",
    "source"
  ],
  "properties": {
    "installation_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{7,127}$" },
    "observed_at": { "type": "integer", "minimum": 0 },
    "today_tokens": { "type": "integer", "minimum": 0 },
    "total_tokens": { "type": "integer", "minimum": 0 },
    "today_cost_usd": { "type": "number", "minimum": 0 },
    "total_cost_usd": { "type": "number", "minimum": 0 },
    "cost_label": { "const": "标准 API 等价费用" },
    "source": { "enum": ["ccusage", "ccusage_codex"] }
  }
}
