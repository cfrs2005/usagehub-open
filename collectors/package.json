{
  "name": "@usagehub/collectors",
  "version": "0.1.0",
  "private": false,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "test:claude": "npm run build && node --test dist/test/claude.test.js dist/test/signer.test.js",
    "test:codex": "npm run build && node --test dist/test/codex.test.js",
    "test:local-usage": "npm run build && node --test dist/test/local-usage.test.js",
    "codex:run": "npm run build && node dist/src/cli/codex-collector.js",
    "codex:smoke": "npm run build && node dist/src/cli/codex-collector.js --smoke-count 3 --no-upload",
    "local-usage": "npm run build && node dist/src/cli/local-usage.js"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "typescript": "5.8.3"
  }
}
