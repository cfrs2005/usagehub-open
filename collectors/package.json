{
  "name": "@usagehub/collectors",
  "version": "0.1.1",
  "private": false,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node -e \"const fs=require('node:fs'),cp=require('node:child_process');const files=fs.readdirSync('test').filter(f=>f.endsWith('.test.ts')).map(f=>'dist/test/'+f.replace(/\\.ts$/,'.js'));const r=cp.spawnSync(process.execPath,['--test',...files],{stdio:'inherit'});process.exit(r.status??1)\"",
    "test:claude": "npm run build && node --test dist/test/claude.test.js dist/test/signer.test.js",
    "test:codex": "npm run build && node --test dist/test/codex.test.js",
    "test:local-usage": "npm run build && node --test dist/test/local-usage.test.js",
    "codex:run": "npm run build && node dist/src/cli/codex-collector.js",
    "codex:smoke": "npm run build && node dist/src/cli/codex-collector.js --smoke-count 3 --no-upload",
    "local-usage": "npm run build && node dist/src/cli/local-usage.js",
    "enroll": "npm run build && node dist/src/cli/enroll.js",
    "collect-now": "npm run build && node dist/src/cli/collect-now.js"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "typescript": "5.8.3"
  }
}
